### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. LOGIN YARA (ADMIN)
### =========================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenYara", response.body.token);
    client.log("✅ Token Yara capturé");
%}


### =========================================================
### 2. REGISTER FATOU + BOUBA
### =========================================================

### 2.1 — Register Fatou
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "fatou",
  "email": "fatou@innovatech.com",
  "password": "password123",
  "prenom": "Fatou",
  "nom": "Sow"
}

### 2.2 — Register Bouba
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "bouba",
  "email": "bouba@innovatech.com",
  "password": "password123",
  "prenom": "Bouba",
  "nom": "Diop"
}


### =========================================================
### 3. LOGIN FATOU + BOUBA
### =========================================================

### 3.1 — Login Fatou
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "fatou@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenFatou", response.body.token);
    client.log("✅ Token Fatou capturé");
%}

### 3.2 — Login Bouba
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bouba@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenBouba", response.body.token);
    client.log("✅ Token Bouba capturé");
%}


### =========================================================
### 4. FATOU CRÉE ALI (SELLER)
### =========================================================
POST {{baseUrl}}/sellers
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{
  "username": "ali",
  "email": "ali@innovatech.com",
  "password": "password123",
  "prenom": "Ali",
  "nom": "Ndiaye"
}


### =========================================================
### 5. BOUBA CRÉE MOUSSA (SELLER)
### =========================================================
POST {{baseUrl}}/sellers
Content-Type: application/json
Authorization: Bearer {{tokenBouba}}

{
  "username": "moussa",
  "email": "moussa@innovatech.com",
  "password": "password123",
  "prenom": "Moussa",
  "nom": "Fall"
}


### =========================================================
### 6. LOGIN ALI + MOUSSA
### =========================================================

### 6.1 — Login Ali
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ali@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenAli", response.body.token);
    client.log("✅ Token Ali capturé");
%}

### 6.2 — Login Moussa
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "moussa@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenMoussa", response.body.token);
    client.log("✅ Token Moussa capturé");
%}


### =========================================================
### 7. VÉRIFICATIONS
### =========================================================

### 7.1 — Fatou voit ses SELLERs
GET {{baseUrl}}/sellers
Authorization: Bearer {{tokenFatou}}

### 7.2 — Bouba voit ses SELLERs
GET {{baseUrl}}/sellers
Authorization: Bearer {{tokenBouba}}

### 7.3 — Yara voit TOUS les users
GET {{baseUrl}}/admin/users
Authorization: Bearer {{tokenYara}}