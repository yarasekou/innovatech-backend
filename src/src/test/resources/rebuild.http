### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. AUTHENTIFICATION
### =========================================================

### 1.1 — Register Yara
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "yara",
  "email": "yara@innovatech.com",
  "password": "password123",
  "prenom": "Yara",
  "nom": "Sékou"
}

### 1.2 — Login (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("Token : " + response.body.token.substring(0, 30) + "...");
%}

### 1.3 — Setup Admin
POST {{baseUrl}}/auth/setup-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "secretKey": "innova-setup-key-2026"
}

### 1.4 — Re-login (token avec ROLE_ADMIN)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
%}


