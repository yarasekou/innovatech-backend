### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### ÉTAPE 1 — YARA (ADMIN)
### =========================================================

### 1.1 — Register Yara
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "yara",
  "email": "yara@innovatech.com",
  "password": "password123",
  "prenom": "Yara",
  "nom": "Sékou"
}

### 1.2 — Login Yara (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("✅ Token Yara capturé (user 1)");
%}

### 1.3 — Setup Admin
POST {{baseUrl}}/auth/setup-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "secretKey": "innova-setup-key-2026"
}

### 1.4 — Re-login Yara (ADMIN)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("adminToken", response.body.token);
    client.log("✅ Token ADMIN capturé");
%}


### =========================================================
### ÉTAPE 2 — ALI et MOUSSA (USER, futurs patrons)
### =========================================================

### 2.1 — Register Ali (USER)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "ali",
  "email": "ali@innovatech.com",
  "password": "password123",
  "prenom": "Ali",
  "nom": "Ndiaye"
}

### 2.2 — Register Moussa (USER)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "moussa",
  "email": "moussa@innovatech.com",
  "password": "password123",
  "prenom": "Moussa",
  "nom": "Fall"
}

### 2.3 — Login Ali (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ali@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("aliToken", response.body.token);
    client.log("✅ Token Ali capturé (user 2)");
%}

### 2.4 — Login Moussa (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "moussa@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("moussaToken", response.body.token);
    client.log("✅ Token Moussa capturé (user 3)");
%}


### =========================================================
### ÉTAPE 3 — FATOU et BOUBA créés PAR leurs patrons (SELLERs)
### =========================================================

### 3.1 — Ali crée Fatou (SELLER)
POST {{baseUrl}}/sellers
Content-Type: application/json
Authorization: Bearer {{aliToken}}

{
  "username": "fatou",
  "email": "fatou@innovatech.com",
  "password": "password123",
  "prenom": "Fatou",
  "nom": "Sow"
}

### 3.2 — Moussa crée Bouba (SELLER)
POST {{baseUrl}}/sellers
Content-Type: application/json
Authorization: Bearer {{moussaToken}}

{
  "username": "bouba",
  "email": "bouba@innovatech.com",
  "password": "password123",
  "prenom": "Bouba",
  "nom": "Diop"
}

### 3.3 — Login Fatou (SELLER, capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "fatou@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("fatouToken", response.body.token);
    client.log("✅ Token Fatou capturé (SELLER)");
%}

### 3.4 — Login Bouba (SELLER, capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bouba@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("boubaToken", response.body.token);
    client.log("✅ Token Bouba capturé (SELLER)");
%}


