### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. LOGIN FATOU
### =========================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "fatou@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenFatou", response.body.token);
    client.log("✅ Token Fatou capturé");
%}


### =========================================================
### 2. PRODUITS DE FATOU (accessoires)
### =========================================================

### 2.1 — Chargeur Samsung 25W
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "CHARGEUR-SAM-25W", "nom": "Chargeur Samsung 25W", "description": "Chargeur rapide Samsung", "prix": 15000, "prixAchat": 10000, "stock": 30, "categorieId": 2 }

### 2.2 — Câble USB-C Samsung
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "CABLE-USBC-SAM", "nom": "Câble USB-C Samsung", "description": "Câble de charge USB-C", "prix": 5000, "prixAchat": 3000, "stock": 100, "categorieId": 3 }

### 2.3 — Écouteurs JBL Tune
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "ECOUTEURS-JBL-TUNE", "nom": "Écouteurs JBL Tune", "description": "Écouteurs Bluetooth JBL", "prix": 25000, "prixAchat": 18000, "stock": 20, "categorieId": 4 }

### 2.4 — Xiaomi Power Bank 20000
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "XIAOMI-PB-20000", "nom": "Xiaomi Power Bank 20000 mAh", "description": "Batterie externe Xiaomi", "prix": 35000, "prixAchat": 25000, "stock": 25, "categorieId": 5 }

### 2.5 — SanDisk 64 Go
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "SANDISK-64GO", "nom": "Carte mémoire SanDisk 64 Go", "description": "Carte microSD 64 Go", "prix": 12000, "prixAchat": 8000, "stock": 50, "categorieId": 10 }


### =========================================================
### 3. LOGIN BOUBA
### =========================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bouba@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenBouba", response.body.token);
    client.log("✅ Token Bouba capturé");
%}


