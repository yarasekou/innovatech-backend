### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. AUTHENTIFICATION FATOU
### =========================================================

### 1.1 — Register Fatou
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "fatou",
  "email": "fatou@innovatech.com",
  "password": "password123",
  "prenom": "Fatou",
  "nom": "Sow"
}


### 1.2 — Login Fatou (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "fatou@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenFatou", response.body.token);
    client.log("✅ Token Fatou capturé");
%}


### =========================================================
### 2. PRODUITS DE FATOU
### =========================================================

### 2.1 — iPhone 16 128G (Fatou)
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "IPHONE16-128G", "nom": "iPhone 16 128G (Fatou)", "description": "iPhone vendu par Fatou", "prix": 1180000, "prixAchat": 880000, "stock": 8, "categorieId": 9 }


### 2.2 — Google Pixel 10 Pro 128G (Fatou)
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{ "reference": "PIXEL-10P-128G", "nom": "Google Pixel 10 Pro 128G (Fatou)", "description": "Pixel vendu par Fatou", "prix": 820000, "prixAchat": 620000, "stock": 12, "categorieId": 5 }


