### Variables
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. FATOU CRÉE SES CLIENTS
### =========================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "fatou@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenFatou", response.body.token);
%}

### 1.1 — Client 1 de Fatou
POST {{baseUrl}}/clients
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{
  "nom": "Ndiaye",
  "prenom": "Moussa",
  "email": "moussa.ndiaye@example.com",
  "telephone": "771111111",
  "adresse": "Sacré-Cœur 3",
  "ville": "Dakar",
  "pays": "Sénégal"
}

### 1.2 — Client 2 de Fatou
POST {{baseUrl}}/clients
Content-Type: application/json
Authorization: Bearer {{tokenFatou}}

{
  "nom": "Diop",
  "prenom": "Aminata",
  "email": "aminata.diop@example.com",
  "telephone": "772222222",
  "adresse": "Point E",
  "ville": "Dakar",
  "pays": "Sénégal"
}

### 1.3 — Fatou voit ses clients
GET {{baseUrl}}/clients
Authorization: Bearer {{tokenFatou}}


