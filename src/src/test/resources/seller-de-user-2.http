### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. LOGIN BOUBA
### =========================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bouba@innovatech.com",
  "password": "Bouba123"
}

> {%
    client.global.set("tokenBouba", response.body.token);
    client.log("✅ Token Bouba capturé");
%}


### =========================================================
### 2. BOUBA CRÉE MOUSSA (SELLER)
### =========================================================
POST {{baseUrl}}/sellers
Content-Type: application/json
Authorization: Bearer {{tokenBouba}}

{
  "username": "moussa",
  "email": "moussa@innovatech.com",
  "password": "password123",
  "prenom": "Moussa",
  "nom": "Fall"
}


### =========================================================
### 3. BOUBA VOIT SES SELLERs
### =========================================================
GET {{baseUrl}}/sellers
Authorization: Bearer {{tokenBouba}}


### =========================================================
### 4. LOGIN MOUSSA
### =========================================================
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "moussa@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenMoussa", response.body.token);
    client.log("✅ Token Moussa capturé");
%}