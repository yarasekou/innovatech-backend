### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### ÉTAPE 1 — YARA (ADMIN)
### =========================================================

### 1.1 — Register Yara
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "yara",
  "email": "yara@innovatech.com",
  "password": "password123",
  "prenom": "Yara",
  "nom": "Sékou"
}

### 1.2 — Login Yara (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("✅ Token Yara capturé");
%}

### 1.3 — Setup Admin
POST {{baseUrl}}/auth/setup-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "secretKey": "innova-setup-key-2026"
}

### 1.4 — Re-login Yara (ADMIN)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("✅ Token ADMIN capturé");
%}


### =========================================================
### ÉTAPE 2 — CRÉATION D'UN USER SIMPLE
### =========================================================

### 2.1 — Register Alioune (USER)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "alioune",
  "email": "alioune@innovatech.com",
  "password": "password123",
  "prenom": "Alioune",
  "nom": "Diop"
}

### 2.2 — Login Alioune (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "alioune@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenUser", response.body.token);
    client.log("✅ Token USER Alioune capturé");
%}


### =========================================================
### ÉTAPE 3 — ENTREPRISE D'ALIOUNE
### =========================================================

### 3.1 — Alioune consulte son entreprise (doit renvoyer 404)
GET {{baseUrl}}/entreprises/me
Authorization: Bearer {{tokenUser}}

### 3.2 — Alioune crée son entreprise
POST {{baseUrl}}/entreprises
Content-Type: application/json
Authorization: Bearer {{tokenUser}}

{
  "nom": "Diop Electronics",
  "description": "Vente de matériel électronique à Dakar",
  "email": "contact@diop-electronics.sn",
  "telephone": "+221 77 123 45 67",
  "adresse": "Sacré-Cœur 3, Villa 123",
  "ville": "Dakar",
  "pays": "Sénégal",
  "siret": "12345678901234",
  "devise": "XOF",
  "tvaPercent": 18.00
}

> {%
    client.global.set("entrepriseId", response.body.id);
    client.log("✅ Entreprise créée avec ID : " + response.body.id);
%}

### 3.3 — Alioune tente de créer une 2ᵉ entreprise (doit échouer)
POST {{baseUrl}}/entreprises
Content-Type: application/json
Authorization: Bearer {{tokenUser}}

{
  "nom": "Deuxième Entreprise",
  "email": "second@test.sn"
}

### 3.4 — Alioune consulte son entreprise
GET {{baseUrl}}/entreprises/me
Authorization: Bearer {{tokenUser}}

### 3.5 — Alioune modifie son entreprise
PUT {{baseUrl}}/entreprises/{{entrepriseId}}
Content-Type: application/json
Authorization: Bearer {{tokenUser}}

{
  "nom": "Diop Electronics SARL",
  "description": "Vente de matériel électronique et informatique",
  "email": "contact@diop-electronics.sn",
  "telephone": "+221 77 123 45 67",
  "adresse": "Sacré-Cœur 3, Villa 123",
  "ville": "Dakar",
  "pays": "Sénégal",
  "siret": "12345678901234",
  "devise": "XOF",
  "tvaPercent": 18.00
}


### =========================================================
### ÉTAPE 4 — LOGO ENTREPRISE
### =========================================================

### 4.1 — Alioune upload le logo (⚠️ remplace le chemin par une vraie image)
POST {{baseUrl}}/entreprises/logo
Authorization: Bearer {{tokenUser}}
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="logo.png"
Content-Type: image/png

< ./logo.png
------WebKitFormBoundary7MA4YWxkTrZu0gW--

### 4.2 — Vérifier le logo dans la réponse
GET {{baseUrl}}/entreprises/me
Authorization: Bearer {{tokenUser}}

### 4.3 — Supprimer le logo
DELETE {{baseUrl}}/entreprises/logo
Authorization: Bearer {{tokenUser}}


### =========================================================
### ÉTAPE 5 — SÉCURITÉ / CONTRÔLES D'ACCÈS
### =========================================================

### 5.1 — Yara (ADMIN) voit l'entreprise d'Alioune par ID
GET {{baseUrl}}/entreprises/{{entrepriseId}}
Authorization: Bearer {{token}}

### 5.2 — Yara (ADMIN) tente de créer une entreprise (doit échouer car ADMIN)
POST {{baseUrl}}/entreprises
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nom": "Entreprise Admin",
  "email": "admin@test.sn"
}

### 5.3 — Alioune tente d'accéder à l'entreprise d'un autre (ex: ID 9999)
GET {{baseUrl}}/entreprises/9999
Authorization: Bearer {{tokenUser}}


### =========================================================
### ÉTAPE 6 — SELLER RATTACHÉ À ALIOUNE
### =========================================================

### 6.1 — Alioune crée un SELLER
POST {{baseUrl}}/sellers
Content-Type: application/json
Authorization: Bearer {{tokenUser}}

{
  "username": "fatou",
  "email": "fatou@diop-electronics.sn",
  "password": "password123",
  "prenom": "Fatou",
  "nom": "Ndiaye"
}

### 6.2 — Login Fatou (SELLER)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "fatou@diop-electronics.sn",
  "password": "password123"
}

> {%
    client.global.set("tokenSeller", response.body.token);
    client.log("✅ Token SELLER Fatou capturé");
%}

### 6.3 — Fatou voit l'entreprise de son patron (Alioune)
GET {{baseUrl}}/entreprises/me
Authorization: Bearer {{tokenSeller}}

### 6.4 — Fatou tente de créer une entreprise (doit échouer)
POST {{baseUrl}}/entreprises
Content-Type: application/json
Authorization: Bearer {{tokenSeller}}

{
  "nom": "Entreprise de Fatou",
  "email": "fatou@test.sn"
}