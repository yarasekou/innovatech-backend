### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### 1. AUTHENTIFICATION BOUBA
### =========================================================

### 1.1 — Register Bouba
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "bouba",
  "email": "bouba@innovatech.com",
  "password": "password123",
  "prenom": "Bouba",
  "nom": "Diop"
}


### 1.2 — Login Bouba (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "bouba@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("tokenBouba", response.body.token);
    client.log("✅ Token Bouba capturé");
%}


### =========================================================
### 2. PRODUITS DE BOUBA
### =========================================================

### 2.1 — iPhone 16 256G (Bouba)
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenBouba}}

{ "reference": "IPHONE16-256G", "nom": "iPhone 16 256G (Bouba)", "description": "iPhone vendu par Bouba", "prix": 1380000, "prixAchat": 1020000, "stock": 6, "categorieId": 10 }


### 2.2 — Samsung Galaxy S24 128G (Bouba)
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenBouba}}

{ "reference": "SAM-S24-128G", "nom": "Samsung Galaxy S24 128G (Bouba)", "description": "Samsung vendu par Bouba", "prix": 780000, "prixAchat": 570000, "stock": 10, "categorieId": 16 }


### 2.3 — Tecno Camon 20 (Bouba)
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{tokenBouba}}

{ "reference": "TECNO-CAMON20", "nom": "Tecno Camon 20 (Bouba)", "description": "Tecno vendu par Bouba", "prix": 185000, "prixAchat": 135000, "stock": 15, "categorieId": 21 }


### =========================================================
### 3. VÉRIFICATIONS
### =========================================================

### 3.1 — Bouba voit SES produits
GET {{baseUrl}}/produits
Authorization: Bearer {{tokenBouba}}

### Changer de mot de passe
POST {{baseUrl}}/auth/change-password
Content-Type: application/json
Authorization: Bearer {{tokenBouba}}

{
  "ancienMotDePasse": "password123",
  "nouveauMotDePasse": "Bouba123"
}
