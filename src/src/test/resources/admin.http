### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### ÉTAPE 1 — YARA (ADMIN)
### =========================================================

### 1.1 — Register Yara
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "yara",
  "email": "yara@innovatech.com",
  "password": "password123",
  "prenom": "Yara",
  "nom": "Sékou"
}

### 1.2 — Login Yara (capture token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("✅ Token Yara capturé");
%}

### 1.3 — Setup Admin
POST {{baseUrl}}/auth/setup-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "secretKey": "innova-setup-key-2026"
}

### 1.4 — Re-login Yara (ADMIN)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("✅ Token ADMIN capturé");
%}


