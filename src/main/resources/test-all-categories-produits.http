### =========================================================
### 2. CATÉGORIES + PRODUITS DE BOUBA (Ali Électronique)
### =========================================================

### ─────────────────────────────────────────
### 2.1 — Racine : Éclairage
### ─────────────────────────────────────────
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "nom": "Éclairage",
  "description": "Ampoules et luminaires",
  "actif": true
}

> {%
    client.global.set("boubaEclairage", response.body.id);
%}

### ─────────────────────────────────────────
### 2.2 — Sous-cat : Ampoules connectées
### ─────────────────────────────────────────
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "nom": "Ampoules connectées",
  "parentId": {{boubaEclairage}},
  "actif": true
}

> {%
    client.global.set("boubaAmpoules", response.body.id);
%}

### ─────────────────────────────────────────
### 2.3 — Sous-sous-cat : Philips Hue
### ─────────────────────────────────────────
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "nom": "Philips Hue",
  "parentId": {{boubaAmpoules}},
  "actif": true
}

> {%
    client.global.set("boubaPhilips", response.body.id);
%}

### ─────────────────────────────────────────
### 2.4 — Sous-sous-cat : LIFX
### ─────────────────────────────────────────
POST {{baseUrl}}/categories
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "nom": "LIFX",
  "parentId": {{boubaAmpoules}},
  "actif": true
}

> {%
    client.global.set("boubaLifx", response.body.id);
%}

### ─────────────────────────────────────────
### 2.5 — Produit Philips Hue White
### ─────────────────────────────────────────
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "reference": "PHILIPS-HUE-WHITE",
  "nom": "Philips Hue White & Color",
  "prix": 45000.00,
  "prixAchat": 32000.00,
  "stock": 20,
  "categorieId": {{boubaPhilips}},
  "actif": true
}

### ─────────────────────────────────────────
### 2.6 — Produit LIFX Mini
### ─────────────────────────────────────────
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "reference": "LIFX-MINI",
  "nom": "LIFX Mini White",
  "prix": 35000.00,
  "prixAchat": 25000.00,
  "stock": 15,
  "categorieId": {{boubaLifx}},
  "actif": true
}


