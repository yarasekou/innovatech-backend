### =========================================================
### ÉTAPE 10 — COMMANDES (par boutique)
### =========================================================

### 10.1 — Fatou commande multi-produits
POST {{baseUrl}}/commandes
Content-Type: application/json
Authorization: Bearer {{fatouToken}}

{
  "clientId": {{fatouClient1}},
  "tvaPercent": 18.00,
  "notes": "Commande Fatou multi-produits",
  "lignes": [
    { "produitId": {{fatouProduit1}}, "quantite": 2 },
    { "produitId": {{fatouProduit2}}, "quantite": 1 }
  ]
}

> {%
    client.global.set("fatouCmd1", response.body.id);
    client.log("✅ Commande Fatou : " + response.body.numero);
%}

### 10.2 — Bouba commande
POST {{baseUrl}}/commandes
Content-Type: application/json
Authorization: Bearer {{boubaToken}}

{
  "clientId": {{boubaClient1}},
  "tvaPercent": 18.00,
  "lignes": [
    { "produitId": {{boubaProduit1}}, "quantite": 1 }
  ]
}

> {%
    client.global.set("boubaCmd1", response.body.id);
%}

### 10.3 — Ibrahima commande
POST {{baseUrl}}/commandes
Content-Type: application/json
Authorization: Bearer {{ibrahimaToken}}

{
  "clientId": {{ibrahimaClient1}},
  "tvaPercent": 18.00,
  "lignes": [
    { "produitId": {{ibrahimaProduit1}}, "quantite": 1 }
  ]
}

> {%
    client.global.set("ibrahimaCmd1", response.body.id);
%}


### =========================================================
### ÉTAPE 11 — PAIEMENTS
### =========================================================

### 11.1 — Fatou paie le solde
POST {{baseUrl}}/paiements
Content-Type: application/json
Authorization: Bearer {{fatouToken}}

{
  "commandeId": {{fatouCmd1}},
  "montant": 29500.00,
  "methode": "WAVE",
  "reference": "TX-FATOU-001"
}

> {%
    client.global.set("fatouPaiement", response.body.id);
%}

### 11.2 — Reste à payer Fatou
GET {{baseUrl}}/paiements/commande/{{fatouCmd1}}/reste
Authorization: Bearer {{fatouToken}}


### =========================================================
### ÉTAPE 12 — STATUTS commande
### =========================================================

### 12.1 — Fatou → EN_COURS
PATCH {{baseUrl}}/commandes/{{fatouCmd1}}/statut/EN_COURS
Authorization: Bearer {{fatouToken}}

### 12.2 — Fatou → LIVREE
PATCH {{baseUrl}}/commandes/{{fatouCmd1}}/statut/LIVREE
Authorization: Bearer {{fatouToken}}


