### =========================================================
### VARIABLES
### =========================================================
@baseUrl = http://localhost:8080/api


### =========================================================
### ÉTAPE 1 — SUPER_ADMIN (bootstrap)
### =========================================================

### 1.1 — Créer le SUPER_ADMIN (une seule fois)
POST {{baseUrl}}/auth/setup-super-admin
Content-Type: application/json

{
  "username": "yara",
  "email": "yara@innovatech.com",
  "password": "password123",
  "prenom": "Yara",
  "nom": "Sékou",
  "secretKey": "innova-setup-key-2026"
}

> {%
    client.global.set("yaraToken", response.body.token);
    client.log("✅ SUPER_ADMIN Yara");
%}


### =========================================================
### ÉTAPE 2 — ADMINs + Entreprises (3)
### =========================================================

### 2.1 — Ali (ADMIN)
POST {{baseUrl}}/auth/register-admin
Content-Type: application/json

{
  "username": "ali",
  "email": "ali@innovatech.com",
  "password": "password123",
  "prenom": "Ali",
  "nom": "Ndiaye",
  "entreprise": {
    "nom": "Ali Électronique",
    "email": "contact@ali-elec.sn",
    "ville": "Dakar",
    "pays": "Sénégal",
    "devise": "XOF",
    "tvaPercent": 18.00
  }
}

> {%
    client.global.set("aliToken", response.body.token);
    client.log("✅ ADMIN Ali");
%}

### 2.2 — Moussa (ADMIN)
POST {{baseUrl}}/auth/register-admin
Content-Type: application/json

{
  "username": "moussa",
  "email": "moussa@innovatech.com",
  "password": "password123",
  "prenom": "Moussa",
  "nom": "Fall",
  "entreprise": {
    "nom": "Fall Informatique",
    "email": "contact@fall-info.sn",
    "ville": "Dakar",
    "pays": "Sénégal",
    "devise": "XOF",
    "tvaPercent": 18.00
  }
}

> {%
    client.global.set("moussaToken", response.body.token);
    client.log("✅ ADMIN Moussa");
%}

### 2.3 — Awa (ADMIN)
POST {{baseUrl}}/auth/register-admin
Content-Type: application/json

{
  "username": "awa",
  "email": "awa@innovatech.com",
  "password": "password123",
  "prenom": "Awa",
  "nom": "Diallo",
  "entreprise": {
    "nom": "Awa Textile",
    "email": "contact@awa-textile.sn",
    "ville": "Saint-Louis",
    "pays": "Sénégal",
    "devise": "XOF",
    "tvaPercent": 18.00
  }
}

> {%
    client.global.set("awaToken", response.body.token);
    client.log("✅ ADMIN Awa");
%}


