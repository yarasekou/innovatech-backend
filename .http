### =========================================================
### 1. AUTHENTIFICATION
### =========================================================

### 1.1 — Register
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "yara",
  "email": "yara@innovatech.com",
  "password": "password123",
  "prenom": "Yara",
  "nom": "Sékou"
}

### 1.2 — Login (capture auto du token)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}


### 1.3 — Setup Admin (une seule fois)
POST {{baseUrl}}/auth/setup-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "secretKey": "innova-setup-key-2026"
}

### 1.4 — Re-login (nouveau token ADMIN)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "yara@innovatech.com",
  "password": "password123"
}

> {%
    client.global.set("token", response.body.token);
    client.log("Nouveau token ADMIN capturé");
%}


### =========================================================
### 2. CLIENTS
### =========================================================

### 2.1 — Liste tous les clients
GET {{baseUrl}}/clients
Authorization: Bearer {{token}}

### 2.2 — Clients actifs
GET {{baseUrl}}/clients/actifs
Authorization: Bearer {{token}}

### 2.3 — Client par ID
GET {{baseUrl}}/clients/1
Authorization: Bearer {{token}}

### 2.4 — Rechercher clients
GET {{baseUrl}}/clients/search?q=Diop
Authorization: Bearer {{token}}

### 2.5 — Créer un client
POST {{baseUrl}}/clients
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nom": "Diop",
  "prenom": "Aminata",
  "email": "aminata.diop@example.com",
  "telephone": "771234567",
  "adresse": "Sacré-Cœur 3",
  "ville": "Dakar",
  "pays": "Sénégal"
}

### 2.6 — Modifier un client
PUT {{baseUrl}}/clients/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "nom": "Diop",
  "prenom": "Aminata",
  "email": "aminata.diop@example.com",
  "telephone": "771234567",
  "adresse": "Nouvelle adresse",
  "ville": "Thiès",
  "pays": "Sénégal",
  "actif": true
}

### 2.7 — Désactiver un client
PATCH {{baseUrl}}/clients/1/deactivate
Authorization: Bearer {{token}}

### 2.8 — Supprimer un client (ADMIN)
DELETE {{baseUrl}}/clients/1
Authorization: Bearer {{token}}


### =========================================================
### 3. PRODUITS
### =========================================================

### 3.1 — Liste tous les produits
GET {{baseUrl}}/produits
Authorization: Bearer {{token}}

### 3.2 — Produits actifs
GET {{baseUrl}}/produits/actifs
Authorization: Bearer {{token}}

### 3.3 — Produit par ID
GET {{baseUrl}}/produits/2
Authorization: Bearer {{token}}

### 3.4 — Produit par référence
GET {{baseUrl}}/produits/reference/PROD-001
Authorization: Bearer {{token}}

### 3.5 — Produits par catégorie
GET {{baseUrl}}/produits/categorie/Iphone
Authorization: Bearer {{token}}

### 3.6 — Rechercher produits
GET {{baseUrl}}/produits/search?q=iPhone
Authorization: Bearer {{token}}

### 3.7 — Produits en stock faible
GET {{baseUrl}}/produits/stock-faible?seuil=10
Authorization: Bearer {{token}}

### 3.8 — Créer un produit
POST {{baseUrl}}/produits
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reference": "PROD-001",
  "nom": "iPhone 16 Pro",
  "description": "Smartphone Apple",
  "prix": 3500000.00,
  "prixAchat": 3000000.00,
  "stock": 10,
  "categorie": "Iphone"
}

### 3.9 — Modifier un produit
PUT {{baseUrl}}/produits/2
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "reference": "PROD-008",
  "nom": "iPhone 16 Pro",
  "description": "Smartphone Apple",
  "prix": 3500000.00,
  "prixAchat": 3000000.00,
  "stock": 10,
  "categorie": "Iphone"
}

### 3.10 — Supprimer un produit (ADMIN)
DELETE {{baseUrl}}/produits/2
Authorization: Bearer {{token}}


### =========================================================
### 4. FOURNISSEURS
### =========================================================

### 4.1 — Liste tous les fournisseurs
GET {{baseUrl}}/fournisseurs
Authorization: Bearer {{token}}

### 4.2 — Fournisseurs actifs
GET {{baseUrl}}/fournisseurs/actifs
Authorization: Bearer {{token}}

### 4.3 — Fournisseur par ID
GET {{baseUrl}}/fournisseurs/1
Authorization: Bearer {{token}}

### 4.4 — Fournisseur par code
GET {{baseUrl}}/fournisseurs/code/FOUR-001
Authorization: Bearer {{token}}

### 4.5 — Fournisseurs par pays
GET {{baseUrl}}/fournisseurs/pays/France
Authorization: Bearer {{token}}

### 4.6 — Créer un fournisseur
POST {{baseUrl}}/fournisseurs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "FOUR-002",
  "nom": "Shenzhen Electronics Co.",
  "email": "contact@shenzhen-elec.cn",
  "telephone": "+86 755 1234 5678",
  "adresse": "1234 Huaqiangbei Road, Futian District",
  "ville": "Shenzhen",
  "pays": "Chine",
  "contactNom": "Li Wei"
}

### 4.7 — Modifier un fournisseur
PUT {{baseUrl}}/fournisseurs/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "code": "FOUR-001",
  "nom": "Apple France",
  "email": "contact@apple.fr",
  "telephone": "+33 1 23 45 67 89",
  "adresse": "8 Rue de Londres",
  "ville": "Paris",
  "pays": "France",
  "contactNom": "Jean Dupont"
}

### 4.8 — Désactiver un fournisseur
PATCH {{baseUrl}}/fournisseurs/1/deactivate
Authorization: Bearer {{token}}

### 4.9 — Supprimer un fournisseur (ADMIN)
DELETE {{baseUrl}}/fournisseurs/1
Authorization: Bearer {{token}}


### =========================================================
### 5. COMMANDES DE VENTE
### =========================================================

### 5.1 — Liste toutes les commandes
GET {{baseUrl}}/commandes
Authorization: Bearer {{token}}

### 5.2 — Commande par ID
GET {{baseUrl}}/commandes/1
Authorization: Bearer {{token}}

### 5.3 — Commande par numéro
GET {{baseUrl}}/commandes/numero/CMD-2026-0001
Authorization: Bearer {{token}}

### 5.4 — Commandes d'un client
GET {{baseUrl}}/commandes/client/1
Authorization: Bearer {{token}}

### 5.5 — Commandes par statut
GET {{baseUrl}}/commandes/statut/EN_ATTENTE
Authorization: Bearer {{token}}

### 5.6 — Créer une commande de vente
POST {{baseUrl}}/commandes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clientId": 1,
  "tvaPercent": 0,
  "notes": "Commande urgente",
  "dateLivraisonPrevue": "2026-10-15",
  "lignes": [
    { "produitId": 1, "quantite": 30, "prixUnitaire": 1200000 }
  ]
}

### 5.7 — Modifier une commande (EN_ATTENTE uniquement)
PUT {{baseUrl}}/commandes/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "clientId": 1,
  "tvaPercent": 18.00,
  "notes": "Commande modifiée",
  "lignes": [
    { "produitId": 2, "quantite": 3 }
  ]
}

### 5.8 — EN_ATTENTE → VALIDEE
PATCH {{baseUrl}}/commandes/1/statut/VALIDEE
Authorization: Bearer {{token}}

### 5.9 — VALIDEE → EN_COURS
PATCH {{baseUrl}}/commandes/1/statut/EN_COURS
Authorization: Bearer {{token}}

### 5.10 — EN_COURS → LIVREE (stock -N)
PATCH {{baseUrl}}/commandes/1/statut/LIVREE
Authorization: Bearer {{token}}

### 5.11 — Annuler
PATCH {{baseUrl}}/commandes/1/statut/ANNULEE
Authorization: Bearer {{token}}

### 5.12 — Supprimer une commande (ADMIN)
DELETE {{baseUrl}}/commandes/1
Authorization: Bearer {{token}}


### =========================================================
### 6. PAIEMENTS
### =========================================================

### 6.1 — Liste tous les paiements
GET {{baseUrl}}/paiements
Authorization: Bearer {{token}}

### 6.2 — Paiements d'une commande
GET {{baseUrl}}/paiements/commande/1
Authorization: Bearer {{token}}

### 6.3 — Reste à payer d'une commande
GET {{baseUrl}}/paiements/commande/1/reste
Authorization: Bearer {{token}}

### 6.4 — Enregistrer un paiement (WAVE)
POST {{baseUrl}}/paiements
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "commandeId": 1,
  "montant": 2000000.00,
  "methode": "WAVE",
  "reference": "TX-WAVE-001",
  "notes": "Acompte 1"
}

### 6.5 — Enregistrer un paiement (ORANGE_MONEY)
POST {{baseUrl}}/paiements
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "commandeId": 1,
  "montant": 2130000.00,
  "methode": "ORANGE_MONEY",
  "reference": "TX-OM-001"
}

### 6.6 — Paiements par statut
GET {{baseUrl}}/paiements/statut/VALIDE
Authorization: Bearer {{token}}

### 6.7 — Rembourser un paiement
PATCH {{baseUrl}}/paiements/1/statut/REMBOURSE
Authorization: Bearer {{token}}

### 6.8 — Annuler un paiement
PATCH {{baseUrl}}/paiements/1/statut/ANNULE
Authorization: Bearer {{token}}

### 6.9 — Supprimer un paiement (ADMIN)
DELETE {{baseUrl}}/paiements/1
Authorization: Bearer {{token}}


### =========================================================
### 7. COMMANDES D'ACHAT
### =========================================================

### 7.1 — Liste toutes les commandes d'achat
GET {{baseUrl}}/commandes-achat
Authorization: Bearer {{token}}

### 7.2 — Commande d'achat par ID
GET {{baseUrl}}/commandes-achat/1
Authorization: Bearer {{token}}

### 7.3 — Commande d'achat par numéro
GET {{baseUrl}}/commandes-achat/numero/ACH-2026-0001
Authorization: Bearer {{token}}

### 7.4 — Commandes d'achat d'un fournisseur
GET {{baseUrl}}/commandes-achat/fournisseur/1
Authorization: Bearer {{token}}

### 7.5 — Commandes d'achat par statut
GET {{baseUrl}}/commandes-achat/statut/EN_ATTENTE
Authorization: Bearer {{token}}

### 7.6 — Créer une commande d'achat
POST {{baseUrl}}/commandes-achat
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "fournisseurId": 2,
  "tvaPercent": 0,
  "notes": "Réappro Pixels depuis Shenzhen (prix négocié)",
  "dateReceptionPrevue": "2026-10-10",
  "lignes": [
    { "produitId": 1, "quantite": 50, "prixAchatUnitaire": 300000 }
  ]
}

### Modifier une commande d'achat
PUT {{baseUrl}}/commandes-achat/2
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "fournisseurId": 2,
  "notes": "Réappro Pixels depuis Shenzhen (modifié)",
  "dateReceptionPrevue": "2026-10-20",
  "totalHt": 15000000,
  "totalTtc": 15000000,
  "tvaPercent": 0,
  "lignes": [
    { "produitId": 1, "quantite": 50, "prixAchatUnitaire": 300000, "sousTotal": 15000000 }
  ]
}

### Supprimer une commande d'achat #1
DELETE {{baseUrl}}/commandes-achat/1
Authorization: Bearer {{token}}

### 7.7 — EN_ATTENTE → COMMANDEE
PATCH {{baseUrl}}/commandes-achat/1/statut/COMMANDEE
Authorization: Bearer {{token}}

### 7.8 — COMMANDEE → RECUE (STOCK +N ✅)
PATCH {{baseUrl}}/commandes-achat/1/statut/RECUE
Authorization: Bearer {{token}}

### 7.9 — RECU_PARTIEL (optionnel)
PATCH {{baseUrl}}/commandes-achat/1/statut/RECU_PARTIEL
Authorization: Bearer {{token}}

### 7.10 — Annuler une commande d'achat
PATCH {{baseUrl}}/commandes-achat/1/statut/ANNULEE
Authorization: Bearer {{token}}

### 7.11 — Supprimer une commande d'achat (ADMIN)
DELETE {{baseUrl}}/commandes-achat/1
Authorization: Bearer {{token}}


### =========================================================
### 8. ADMIN
### =========================================================

### 8.1 — Liste tous les utilisateurs
GET {{baseUrl}}/admin/users
Authorization: Bearer {{token}}

### 8.2 — Utilisateur par ID
GET {{baseUrl}}/admin/users/1
Authorization: Bearer {{token}}

### 8.3 — Promouvoir un user en ADMIN
PATCH {{baseUrl}}/admin/users/2/promote
Authorization: Bearer {{token}}

### 8.4 — Rétrograder un ADMIN
PATCH {{baseUrl}}/admin/users/2/demote
Authorization: Bearer {{token}}

### 8.5 — Toggle actif
PATCH {{baseUrl}}/admin/users/2/toggle-actif
Authorization: Bearer {{token}}